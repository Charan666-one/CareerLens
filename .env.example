# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------

# Backend
DATABASE_URL=postgresql://postgres:password@localhost:5432/careerlens
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of origins allowed to call the API. This MUST list the
# exact scheme+host+port the frontend is served from, or the browser blocks
# every request with a CORS error.
CORS_ORIGINS=http://localhost:5173

# Frontend. Vite inlines VITE_* variables at BUILD time - changing this on a
# running container has no effect, it has to be set before `npm run build`
# (or passed as a Docker build arg; see frontend/Dockerfile).
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Production notes
# ---------------------------------------------------------------------------
# Set these as environment variables on the host/platform - never commit a
# real .env (it is gitignored, and backend/.dockerignore keeps it out of the
# built image).
#
#   DATABASE_URL        Connection string for the managed Postgres instance.
#   SECRET_KEY          Long random string; rotating it invalidates all
#                       existing JWTs, logging every user out.
#                       Generate with: openssl rand -hex 32
#   CORS_ORIGINS        The deployed frontend URL, e.g.
#                       https://careerlens.up.railway.app
#                       Leaving this at the localhost default is the most
#                       common cause of "works locally, dead in production".
#   VITE_API_BASE_URL   The deployed backend URL. Build arg, not runtime env.
#
# The backend image runs `alembic upgrade head && python -m app.db.seed` on
# boot. The seed step is required: migrations create the skills/jobs/edges
# tables but leave them empty, and an empty knowledge base makes every
# pipeline stage return 200 with no results.
#
# Run the backend at a single replica. Multiple replicas would race
# `alembic upgrade head` against the same database on boot.
